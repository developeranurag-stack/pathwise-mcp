# Must point at the SAME Postgres database as the app that reads
# gov_job_notifications / gov_job_posts. Do not invent a second database.
DATABASE_URL=postgresql://user:password@localhost:5432/pathwise?sslmode=require

# Optional LLM for auto-extract. If none of these is set, the server logs
# LLM_SKIP and uses the deterministic fallback (kind + issuer + post splitters).
# LLM_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-2-1212

# Crawl every registered official host for new advertisement PDFs:
# State PSCs, UPSC/SSC/RRB, and exam boards (CG VYAPAM, MP ESB, RSMSSB, …).
# Off by default. Pickup-folder polling still runs every POLL_SECONDS.
# One-shot: python server.py --fetch --apply --codes=CGVYAPAM,MPESB
# FETCH_COMMISSIONS=false
# FETCH_INTERVAL_SECONDS=21600
# FETCH_MAX_PDFS_PER_HOST=3
# POLL_SECONDS=5
# Optional: PathWise PDF resolver if the two apps do not share a relative tree.
# GOV_JOB_PDF_DIR=/absolute/path/to/pathwise-mcp/stored_pdfs
